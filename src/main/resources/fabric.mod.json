{
	"schemaVersion": 1,
	"id": "halloween",
	"version": "${version}",
	"name": "Halloween",
	"description": "Halloween: The Game (IllFonic) gameplay recreated in Minecraft. Private build.",
	"authors": ["RinusC"],
	"license": "All-Rights-Reserved",
	"icon": "assets/halloween/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.halloween.Halloween"],
		"client": ["dev.halloween.client.HalloweenClient"]
	},
	"mixins": [
		"halloween.mixins.json",
		{ "config": "halloween.client.mixins.json", "environment": "client" },
		{ "config": "halloween.vr.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"vivecraft": ">=1.3.0"
	},
	"breaks": {
		"vivecraft": "<1.3.0"
	}
}
